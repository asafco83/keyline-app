{
  "name": "keyline",
  "version": "0.1.0",
  "description": "Keyline: browser-based SVG animation editor that exports a single self-contained animated SVG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.8",
    "happy-dom": "^15.11.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18"
  }
}
